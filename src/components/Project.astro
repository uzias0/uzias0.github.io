---
import SectionHeader from './SectionHeader.astro';

interface ProjectItem {
  title: string;
  subtitle: string;
  status: string;
  statusTone: 'accent' | 'amber' | 'muted';
  description: string;
  stack: string[];
  site?: string;
  repo?: string;
  links?: { label: string; href: string }[];
  note?: string;
}

interface Group {
  label: string;
  lede: string;
  compact?: boolean;
  items: ProjectItem[];
}

const groups: Group[] = [
  {
    label: 'Produtos e projetos pessoais',
    lede: 'Plataformas que desenho, construo e mantenho por conta própria.',
    items: [
      {
        title: 'APROVA+',
        subtitle: 'Plataforma de preparação para concursos públicos e vestibulares com IA',
        status: 'Em desenvolvimento',
        statusTone: 'accent',
        description:
          'Projeto pessoal de estudo para concursos e vestibulares: banco de questões com filtros por matéria/concurso/banca, simulados (modo treino e modo prova), revisão espaçada e um módulo de redação com correção por IA. Inclui um motor de ensino adaptativo próprio — diagnóstico probabilístico do motivo do erro, dicas progressivas, resolução guiada passo a passo, mini-aulas e reforço gerados sob demanda, e um mapa de domínio por tópico que decide o que estudar a seguir.',
        stack: ['Next.js', 'TypeScript', 'Prisma', 'PostgreSQL', 'Gemini API', 'Vitest'],
        note: 'Repositório privado',
      },
      {
        title: 'ALVORA',
        subtitle: 'Plataforma SaaS multiempresa de gestão para pequenos e médios negócios',
        status: 'Projeto pessoal',
        statusTone: 'amber',
        description:
          'Sistema de gestão empresarial que se adapta ao segmento de cada cliente: uma açaiteria, um eletricista e uma assistência técnica usam a mesma plataforma, mas com fluxo e recursos priorizados de forma diferente. Reúne CRM, catálogo de produtos, estoque, financeiro, vendas, PDV, orçamentos, ordens de serviço, agenda e um portal público — com isolamento de dados entre empresas, controle de permissões e módulo fiscal (NFC-e) em fase de homologação. Funciona como aplicativo instalável (PWA), com um projeto Android em paralelo.',
        stack: ['TypeScript', 'Multiempresa', 'PDV', 'Financeiro', 'Fiscal (NFC-e)', 'PWA'],
        note: 'Repositório privado',
      },
      {
        title: 'Estuda+',
        subtitle: 'Plataforma de aprendizagem + enciclopédia acadêmica de Psicologia',
        status: 'Em desenvolvimento',
        statusTone: 'accent',
        description:
          'Projeto pessoal em construção: fundação técnica (módulo 1) concluída, com banco de dados, autenticação e infraestrutura de testes prontos — a interface e o conteúdo do produto ainda estão por vir.',
        stack: ['Next.js', 'TypeScript', 'Prisma', 'PostgreSQL', 'Capacitor', 'Vitest'],
        site: 'https://estuda-mais-lqwv.onrender.com',
        repo: 'https://github.com/uzias0/estuda-mais',
      },
      {
        title: 'PetPulse',
        subtitle: 'Plataforma brasileira de valores de pets para trocas no Adopt Me (Roblox)',
        status: 'Em desenvolvimento',
        statusTone: 'accent',
        description:
          'Plataforma em português para consultar o valor dos pets nas trocas do Adopt Me, inspirada em sites de valores internacionais e voltada ao público brasileiro. Vai além do código: cuido também da divulgação, com roteiros, narração e vídeos para o TikTok do projeto.',
        stack: [],
        links: [{ label: 'TikTok @pet.pulse7', href: 'https://www.tiktok.com/@pet.pulse7' }],
      },
    ],
  },
  {
    label: 'Jogos',
    lede: 'Criação de jogos no Roblox Studio, com modelos e animações feitos no Blender.',
    items: [
      {
        title: 'Lootlings',
        subtitle: 'Jogo de pets com mapa de ilhas flutuantes, publicado no Roblox',
        status: 'Publicado',
        statusTone: 'amber',
        description:
          'Meu primeiro jogo publicado no Roblox: coleção de pets em um mapa de ilhas flutuantes. Construído no Roblox Studio com apoio de IA conectada ao editor (Claude Code + MCP). Segue em evolução, com planos de multiplayer, novos mundos e visuais modelados no Blender em vez de peças geométricas simples.',
        stack: ['Roblox Studio', 'Blender', 'Claude Code'],
      },
      {
        title: 'Jogo de ovos e criaturas',
        subtitle: 'Novo projeto multiplayer no Roblox',
        status: 'Em desenvolvimento',
        statusTone: 'accent',
        description:
          'Novo jogo em servidores cheios de jogadores: ovos e criaturas com raridade, mecânica de roubo enquanto a criatura é carregada, troca entre jogadores e loja. As criaturas têm estilo próprio de cerâmica pintada, modeladas e animadas no Blender.',
        stack: ['Roblox Studio', 'Blender', 'Game design'],
      },
    ],
  },
  {
    label: 'Projetos profissionais',
    lede: 'Sistemas que desenvolvi no meu trabalho atual. São propriedade da empresa, por isso não exibo nome, código nem capturas de tela.',
    compact: true,
    items: [
      {
        title: 'Sistema de gestão financeira e de compras',
        subtitle: 'Contas a pagar, compras e recebimento para uma empresa do agronegócio',
        status: 'Projeto profissional',
        statusTone: 'muted',
        description:
          'Portal full-stack que conduzi da arquitetura ao desenvolvimento. Automatiza parte do fluxo de contas a pagar — identifica notas fiscais e boletos recebidos por e-mail e vincula aos lançamentos corretos quando a confiança é alta — e cobre pedidos de compra com fluxo de aprovação por alçada, gestão de fornecedores, perfis de permissão, assistente com IA e um módulo de recebimento de mercadorias. Sincroniza o status com o ERP da empresa.',
        stack: [],
        note: 'Projeto confidencial',
      },
      {
        title: 'Plataforma de exibição de conteúdo',
        subtitle: 'Digital signage interno para TVs corporativas',
        status: 'Projeto profissional',
        statusTone: 'muted',
        description:
          'Painel de administração para gerenciar o que é exibido nas TVs da empresa: fotos, vídeos e páginas organizados em playlists por TV ou grupo de TVs, com pareamento simples de novos aparelhos.',
        stack: [],
        note: 'Projeto confidencial',
      },
      {
        title: 'Sistema de gestão de reservas',
        subtitle: 'Agendamento interno de salas de reunião',
        status: 'Projeto profissional',
        statusTone: 'muted',
        description:
          'Sistema interno para consulta de disponibilidade e agendamento de salas de reunião, facilitando a organização do espaço físico da empresa.',
        stack: [],
        note: 'Projeto confidencial',
      },
      {
        title: 'Plataforma de monitoramento de infraestrutura',
        subtitle: 'Dashboard e alertas para o NOC da empresa',
        status: 'Projeto profissional',
        statusTone: 'muted',
        description:
          'Monitoramento de infraestrutura de TI com dashboard e alertas em tempo real, dando apoio à operação do NOC (Network Operations Center) da empresa.',
        stack: [],
        note: 'Projeto confidencial',
      },
    ],
  },
];

const toneClasses: Record<ProjectItem['statusTone'], string> = {
  accent: 'border-accent/35 bg-accent/10 text-accent',
  amber: 'border-amber/40 bg-amber/10 text-amber',
  muted: 'border-line bg-surface-2/60 text-ink-faint',
};

const arrow =
  '<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>';
---
<section id="projetos" class="border-b border-line py-20">
  <div class="mx-auto max-w-wrap px-6">
    <SectionHeader index="05" eyebrow="projetos em destaque" title="Projetos" />

    <div class="space-y-14">
      {groups.map((g) => (
        <div class="reveal reveal-delay-1">
          <div class="mb-5 border-l-2 border-accent pl-4">
            <h3 class="font-mono text-xs uppercase tracking-[0.14em] text-accent">{g.label}</h3>
            <p class="mt-1.5 max-w-2xl text-sm text-ink-soft">{g.lede}</p>
          </div>

          <div class:list={['grid gap-6', g.compact && 'md:grid-cols-2']}>
            {g.items.map((p) => (
              <div
                class:list={[
                  'group relative overflow-hidden rounded-2xl border border-line bg-surface/50 transition-colors hover:border-accent/40',
                  g.compact ? 'p-6' : 'p-7 sm:p-9',
                ]}
              >
                {!g.compact && (
                  <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-accent/10 blur-3xl transition-opacity group-hover:opacity-80"></div>
                )}
                <div class="relative flex flex-wrap items-start justify-between gap-4">
                  <div class="max-w-lg">
                    <h4 class:list={['font-display font-bold', g.compact ? 'text-lg' : 'text-xl sm:text-2xl']}>{p.title}</h4>
                    <p class="mt-1.5 text-sm text-ink-soft">{p.subtitle}</p>
                  </div>
                  <span class={`whitespace-nowrap rounded-full border px-3 py-1 font-mono text-[11px] uppercase tracking-wide ${toneClasses[p.statusTone]}`}>
                    {p.status}
                  </span>
                </div>
                <p class:list={['relative mt-4 text-ink-soft', g.compact ? 'text-sm leading-relaxed' : 'max-w-2xl']}>
                  {p.description}
                </p>
                {p.stack.length > 0 && (
                  <div class="relative mt-5 flex flex-wrap gap-2">
                    {p.stack.map((s) => (
                      <span class="rounded-md border border-line bg-surface-2/60 px-2.5 py-1 font-mono text-xs text-ink-soft">
                        {s}
                      </span>
                    ))}
                  </div>
                )}
                {(p.site || p.repo || p.links || p.note) && (
                  <div class="relative mt-6 flex flex-wrap items-center gap-3">
                    {p.site && (
                      <a
                        href={p.site}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-2 rounded-md border border-accent/50 bg-accent/10 px-4 py-2 font-mono text-sm text-accent transition-all hover:-translate-y-0.5 hover:border-accent"
                      >
                        Ver site <Fragment set:html={arrow} />
                      </a>
                    )}
                    {p.repo && (
                      <a
                        href={p.repo}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-2 rounded-md border border-line bg-surface px-4 py-2 font-mono text-sm transition-all hover:-translate-y-0.5 hover:border-accent"
                      >
                        Ver repositório <Fragment set:html={arrow} />
                      </a>
                    )}
                    {p.links?.map((l) => (
                      <a
                        href={l.href}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-2 rounded-md border border-line bg-surface px-4 py-2 font-mono text-sm transition-all hover:-translate-y-0.5 hover:border-accent"
                      >
                        {l.label} <Fragment set:html={arrow} />
                      </a>
                    ))}
                    {p.note && (
                      <span class="inline-flex items-center gap-1.5 font-mono text-xs text-ink-faint">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        {p.note}
                      </span>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
