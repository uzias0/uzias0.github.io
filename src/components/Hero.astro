---
---
<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 bg-grid-pattern bg-[size:44px_44px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_60%,transparent_100%)]"></div>
  <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-accent/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -left-24 top-40 h-72 w-72 rounded-full bg-amber/5 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-wrap gap-10 px-6 py-20 sm:py-28 lg:grid-cols-[1fr_auto] lg:items-center">
    <div>
      <div class="reveal mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-surface/60 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-accent">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent"></span>
        </span>
        técnico em ti · são paulo, br
      </div>

      <h1 class="reveal reveal-delay-1 text-balance font-display text-5xl font-extrabold leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl">
        Uzias Bastos
        <span class="block bg-gradient-to-r from-ink via-accent to-ink bg-[length:200%_auto] bg-clip-text text-transparent">
          Tacio
        </span>
      </h1>

      <p class="reveal reveal-delay-2 mt-6 max-w-xl text-lg text-ink-soft">
        Suporte técnico e desenvolvimento de sistemas na <span class="font-medium text-ink">Agrosystem</span>,
        cursando Análise e Desenvolvimento de Sistemas. Busco crescer na área de tecnologia aplicando o que
        aprendo no dia a dia.
      </p>

      <div class="reveal reveal-delay-2 mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-sm text-ink-faint">
        <span class="inline-flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent shadow-[0_0_0_3px_rgba(87,214,196,0.18)]"></span>
          atuando na agrosystem desde abr/2026
        </span>
        <span class="text-line">·</span>
        <span>cravinhos, sp</span>
      </div>

      <div class="reveal reveal-delay-3 mt-9 flex flex-wrap gap-3">
        <a
          href="mailto:uziasbtacio@gmail.com"
          class="group inline-flex items-center gap-2 rounded-md border border-accent bg-accent px-5 py-2.5 font-mono text-sm text-accent-ink transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-8px_rgba(87,214,196,0.5)]"
        >
          Enviar e-mail
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a
          href="https://github.com/uzias0"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-md border border-line bg-surface px-5 py-2.5 font-mono text-sm text-ink transition-all hover:-translate-y-0.5 hover:border-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.19 1.82 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.07.78 2.15 0 1.56-.01 2.81-.01 3.19 0 .3.2.66.79.55A10.51 10.51 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z"/></svg>
          GitHub
        </a>
      </div>
    </div>

    <div class="reveal reveal-delay-1 hidden justify-self-end lg:flex">
      <div class="relative flex h-52 w-52 animate-float items-center justify-center">
        <div class="absolute inset-0 rounded-[2.2rem] border border-line bg-surface/60 backdrop-blur-sm"></div>
        <div class="absolute inset-3 rounded-[1.7rem] border border-accent/25 [background:conic-gradient(from_180deg_at_50%_50%,rgba(87,214,196,0.18),transparent_60%)]"></div>
        <span class="relative font-display text-6xl font-extrabold text-ink">UT</span>
      </div>
    </div>
  </div>
</section>
