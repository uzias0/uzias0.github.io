---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  lede?: string;
}
const { index, eyebrow, title, lede } = Astro.props;
---
<div class="reveal mb-10 max-w-2xl">
  <div class="mb-3 flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.14em] text-accent">
    <span class="h-px w-6 bg-accent"></span>
    {index} · {eyebrow}
  </div>
  <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {lede && <p class="mt-3 text-ink-soft">{lede}</p>}
</div>
